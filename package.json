{
  "name": "ryda-v2",
  "version": "2.0.0",
  "private": true,
  "description": "Production-grade ride-hailing platform for Bhopal — Next.js 16 + Postgres/PostGIS + Socket.IO + Redis. 100% free stack (no Mapbox, no Stripe, no Resend).",
  "license": "MIT",
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:ws": "tsx watch workers/socket-server.ts",
    "dev:worker": "tsx watch workers/queue-worker.ts",
    "postinstall": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "biome check src",
    "lint:fix": "biome check src --write",
    "format": "biome format src --write",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:unit": "vitest run --dir tests/unit",
    "test:integration": "vitest run --dir tests/integration",
    "test:e2e": "playwright test",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
