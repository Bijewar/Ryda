{
  "name": "ryda-v2",
  "version": "2.0.0",
  "private": true,
  "description": "Production-grade ride-hailing platform for Bhopal — Next.js 16 + Postgres/PostGIS + Socket.IO + Redis. 100% free stack (no Mapbox, no Stripe, no Resend).",
  "license": "MIT",
  "scripts": {
    "dev": "next dev --webpack",
    "dev:ws": "tsx watch workers/socket-server.ts",
    "dev:worker": "tsx watch workers/queue-worker.ts",
    "postinstall": "prisma generate",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "biome check src",
    "lint:fix": "biome check src --write",
    "format": "biome format src --write",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:unit": "vitest run --dir tests/unit",
    "test:integration": "vitest run --dir tests/integration",
    "test:e2e": "playwright test",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@hookform/resolvers": "^3.9.1",
    "@prisma/client": "6.19.3",
    "@react-email/components": "^0.0.31",
    "@sentry/nextjs": "^8.47.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@t3-oss/env-nextjs": "^0.11.1",
    "@tanstack/react-query": "^5.62.7",
    "@vercel/otel": "^1.10.0",
    "argon2": "^0.41.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ioredis": "^5.4.2",
    "lucide-react": "^0.469.0",
    "maplibre-gl": "^4.7.1",
    "next": "^16.0.0",
    "next-auth": "5.0.0-beta.25",
    "next-themes": "^0.4.4",
    "nodemailer": "^6.9.16",
    "otplib": "^12.0.1",
    "pino": "^9.5.0",
    "posthog-js": "^1.205.0",
    "posthog-node": "^4.7.0",
    "prisma": "6.19.3",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-email": "^3.0.3",
    "react-hook-form": "^7.54.2",
    "react-map-gl": "^8.0.1",
    "recharts": "^2.15.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "msw": "^2.7.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
