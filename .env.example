# ──────────────────────────────────────────────────────────────────────────
# Ryda v2 — Environment Variables (100% FREE STACK)
#
# Copy to `.env` and fill in. When DEMO_MODE=true, the entire app runs
# end-to-end with ZERO external API keys — no Mapbox, no Stripe, no Resend,
# no Twilio, no Upstash. Just Postgres + Redis (via docker-compose).
#
# Required for production:
#   - DATABASE_URL, REDIS_URL  (from docker-compose)
#   - AUTH_SECRET              (run: openssl rand -base64 32)
#   - RAZORPAY_KEY_ID/SECRET   (free signup at razorpay.com — no monthly fee)
#   - SMTP_USER/PASS           (free Gmail account + App Password)
#
# Everything else is optional.
# ──────────────────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────────────────
# Toggle to enable demo mode (mocks for payments + email). Default: false.
DEMO_MODE=true
# Public URL of the deployed app (used for OAuth redirects, webhooks, CORS).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Node environment.
NODE_ENV=development

# ── Database (Postgres 16 + PostGIS) ──────────────────────────────────────
# Started by docker-compose. Format: postgresql://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=postgresql://ryda:ryda@localhost:5432/ryda?schema=public
# Shadow DB used by `prisma migrate` in CI (optional).
SHADOW_DATABASE_URL=postgresql://ryda:ryda@localhost:5432/ryda_shadow?schema=public

# ── Redis (cache + pubsub + BullMQ) ───────────────────────────────────────
# Started by docker-compose.
REDIS_URL=redis://localhost:6379

# ── NextAuth v5 (Auth.js) ─────────────────────────────────────────────────
# Generate with: `openssl rand -base64 32`
AUTH_SECRET=replace-with-openssl-rand-base64-32
# Trust the host header (set to true for Vercel/preview deploys).
AUTH_TRUST_HOST=true
# Google OAuth (optional — credentials provider works without it).
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Payments: Razorpay (the ONLY payment provider) ────────────────────────
# Free signup at https://dashboard.razorpay.com/access/signin
# No monthly fee, no setup fee — only per-transaction pricing (~2% per payment).
# Test mode keys work without any KYC; just create an account.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Public key (safe to expose in client bundle — identifies merchant, not a secret)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ── Email via Gmail SMTP (free with any Gmail account) ────────────────────
# 1. Enable 2FA on your Gmail account: https://myaccount.google.com/security
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-char password below (no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=Ryda <your-email@gmail.com>

# ── Observability (all optional, all have free tiers) ─────────────────────
# Sentry — https://sentry.io (free tier: 5k errors/month)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
# PostHog — https://posthog.com (free tier: 1M events/month, self-host option)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
# OpenTelemetry — OTLP endpoint (Honeycomb free tier, Grafana Cloud free tier)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=ryda-v2

# ── Worker processes ──────────────────────────────────────────────────────
# Port for the standalone Socket.IO server (used by workers/socket-server.ts).
SOCKET_IO_PORT=3001
# Comma-separated list of allowed origins for CORS on the WS server.
SOCKET_IO_ORIGINS=http://localhost:3000

# ── Feature flags ─────────────────────────────────────────────────────────
# Enable surge pricing recompute job (default: true).
ENABLE_SURGE_PRICING=true
# Enable ride timeout cancellation job (default: true).
ENABLE_RIDE_TIMEOUT=true
# Max attempts to find a driver before declaring NO_DRIVERS (default: 3).
MATCHING_MAX_ATTEMPTS=3
# Radius in meters for driver matching (default: 5000 = 5 km).
MATCHING_RADIUS_METERS=5000
